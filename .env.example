# Copiar para .env no VPS antes de arrancar.
# Nao usar passwords/segredos de exemplo em producao.
NODE_ENV=production
PORT=4000

DATABASE_URL="postgresql://postgres:SUA_PASSWORD_FORTE@localhost:5432/cristalwater?connection_limit=50&pool_timeout=15"
JWT_SECRET="gerar_com_openssl_rand_base64_48"
ADMIN_JWT_SECRET="gerar_com_openssl_rand_base64_48"

# Fallback inicial opcional. Depois de criar utilizador admin real na BD,
# podes remover ADMIN_EMAIL/ADMIN_PASSWORD.
ADMIN_EMAIL="admin@cristalwater.local"
ADMIN_PASSWORD="trocar_esta_password"
ALLOW_LEGACY_PLAIN_PASSWORDS=false

PUBLIC_BASE_URL="https://app.cristalwater.pt"
CORS_ORIGIN="https://app.cristalwater.pt"
TRUST_PROXY=true
UPLOAD_DIR="uploads"

ENABLE_BACKGROUND_JOBS=false
AI_ADMIN_ENABLED=true
AI_ADMIN_REQUIRE_APPROVAL=true

# IA administrativa:
# - Sem chave: trabalha em modo local com regras internas.
# - Com chave + ENABLE_ADMIN_AI_OPENAI=true: usa OpenAI apenas nas rotas protegidas de administrador.
# - Web so fica ativa se tambem ligares ENABLE_ADMIN_AI_WEB=true.
ENABLE_ADMIN_AI_OPENAI=false
ENABLE_ADMIN_AI_WEB=false
OPENAI_MODEL="gpt-5.4"
OPENAI_API_KEY=""

WHATSAPP_PROVIDER="DISABLED"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cristal Water <no-reply@cristalwater.pt>"
