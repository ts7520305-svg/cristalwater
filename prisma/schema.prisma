  product     InventoryProduct? @relation(fields: [productId], references: [id])
  purchase    StockPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@index([productName])
  @@index([category])
}

model StockBalance {
  id          Int      @id @default(autoincrement())
  scope       String   @default("CENTRAL")
  vehicleId   Int?
  productId   Int?
  productName String
  category    String?  @default("CHEMICAL")
  unit        String   @default("KG")
  quantity    Float    @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([scope, vehicleId, productName, unit])
  @@index([scope])
  @@index([vehicleId])
  @@index([productName])
  @@index([category])
}

model StockMovement {
  id               Int      @id @default(autoincrement())
  movementType     String
  scopeFrom        String?
  scopeTo          String?
  vehicleId        Int?
  productId        Int?
  productName      String
  category         String?  @default("CHEMICAL")
  unit             String   @default("KG")
  quantity         Float    @default(0)
  purchaseId       Int?
  transportGuideId Int?
  workGuideId      Int?
  visitId          Int?
  clientId         Int?
  poolId           Int?
  technicianId     Int?
  documentPath     String?
  notes            String?
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([movementType])
  @@index([vehicleId])
  @@index([productName])
  @@index([purchaseId])
  @@index([transportGuideId])
  @@index([workGuideId])
  @@index([visitId])
  @@index([createdAt])
}

model OperationalLock {
  id           Int       @id @default(autoincrement())
  lockType     String
  severity     String    @default("WARNING")
  status       String    @default("PENDING")
  entity       String?
  entityId     Int?
  clientId     Int?
  poolId       Int?
  visitId      Int?
  technicianId Int?
  vehicleId    Int?
  title        String
  message      String?
  payload      Json?
  requestedBy  String?
  approvedBy   String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lockType])
  @@index([severity])
  @@index([status])
  @@index([entity, entityId])
  @@index([clientId])
  @@index([poolId])
  @@index([visitId])
  @@index([technicianId])
  @@index([vehicleId])
}

model VisitStateLog {
  id            Int      @id @default(autoincrement())
  visitId       Int
  previousState String?
  newState      String
  reason        String?
  notes         String?
  latitude      Float?
  longitude     Float?
  photoRequired Boolean  @default(false)
  photoUrl      String?
  actor         String?
  createdAt     DateTime @default(now())

  @@index([visitId])
  @@index([newState])
  @@index([createdAt])
}

model SeasonalRule {
  id                       Int      @id @default(autoincrement())
  name                     String
  season                   String   @default("VERAO")
  active                   Boolean  @default(true)
  monthStart               Int?
  monthEnd                 Int?
  minVisitsPerWeek         Float?   @default(1)
  idealVisitsPerWeek       Float?   @default(1)
  filtrationMultiplier     Float?   @default(1)
  chemicalMultiplier       Float?   @default(1)
  saltProductionMultiplier Float?   @default(1)
  monthlyFeeMultiplier     Float?   @default(1)
  appliesTo                String?  @default("ALL")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([season])
  @@index([active])
  @@index([monthStart, monthEnd])
}

model VehicleAccessibilityRule {
  id                Int      @id @default(autoincrement())
  poolId            Int?
  clientId          Int?
  accessibilityType String   @default("LIGEIRO")
  maxVehicleType    String?
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([poolId])
  @@index([clientId])
  @@index([accessibilityType])
  @@index([active])
}

model EmergencyConsumptionBatch {
  id               Int                        @id @default(autoincrement())
  technicianId     Int?
  vehicleId        Int?
  workGuideId      Int?
  date             DateTime                   @default(now())
  status           String                     @default("DRAFT")
  distributionMode String                     @default("PROPORTIONAL")
  notes            String?
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  items            EmergencyConsumptionItem[]

  @@index([technicianId])
  @@index([vehicleId])
  @@index([workGuideId])
  @@index([date])
  @@index([status])
}

model EmergencyConsumptionItem {
  id          Int                       @id @default(autoincrement())
  batchId     Int
  productName String
  unit        String                    @default("KG")
  quantity    Float                     @default(0)
  notes       String?
  createdAt   DateTime                  @default(now())
  batch       EmergencyConsumptionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([productName])
}

model VehicleStockAudit {
  id            Int                     @id @default(autoincrement())
  vehicleId     Int?
  technicianId  Int?
  weekRef       String
  status        String                  @default("OPEN")
  expectedJson  Json?
  countedJson   Json?
  varianceJson  Json?
  varianceValue Float                   @default(0)
  notes         String?
  createdAt     DateTime                @default(now())
  closedAt      DateTime?
  updatedAt     DateTime                @updatedAt
  items         VehicleStockAuditItem[]

  @@index([vehicleId])
  @@index([technicianId])
  @@index([weekRef])
  @@index([status])
}

model VehicleStockAuditItem {
  id          Int               @id @default(autoincrement())
  auditId     Int
  productName String
  unit        String            @default("KG")
  expectedQty Float             @default(0)
  countedQty  Float             @default(0)
  varianceQty Float             @default(0)
  notes       String?
  audit       VehicleStockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([productName])
}

model ClientProfitSnapshot {
  id                 Int      @id @default(autoincrement())
  clientId           Int
  monthRef           String
  revenue            Float    @default(0)
  chemicalCost       Float    @default(0)
  materialCost       Float    @default(0)
  laborCost          Float    @default(0)
  vehicleCost        Float    @default(0)
  extraRevenue       Float    @default(0)
  grossProfit        Float    @default(0)
  grossMarginPercent Float    @default(0)
  status             String   @default("OK")
  recommendation     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([clientId, monthRef])
  @@index([clientId])
  @@index([monthRef])
  @@index([status])
}

model AuditTrail {
  id           Int      @id @default(autoincrement())
  eventType    String
  entity       String?
  entityId     Int?
  userId       Int?
  technicianId Int?
  clientId     Int?
  poolId       Int?
  visitId      Int?
  vehicleId    Int?
  action       String
  message      String?
  beforeJson   Json?
  afterJson    Json?
  metadata     Json?
  latitude     Float?
  longitude    Float?
  serverTime   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([entity, entityId])
  @@index([userId])
  @@index([technicianId])
  @@index([clientId])
  @@index([poolId])
  @@index([visitId])
  @@index([vehicleId])
  @@index([createdAt])
}

model TechnicalSheet {
  id                    Int      @id @default(autoincrement())
  poolId                Int      @unique
  volumeM3              Float    @default(0)
  disinfectionType      String   @default("CLORO")
  targetPhMin           Float    @default(7.2)
  targetPhMax           Float    @default(7.6)
  targetChlorineMin     Float    @default(1.0)
  targetChlorineMax     Float    @default(3.0)
  targetAlkalinityMin   Float    @default(80)
  targetAlkalinityMax   Float    @default(120)
  targetOrpMinMv        Float?
  filterBrandModel      String?
  pumpHorsePower        Float?
  chlorinatorModel      String?
  technicalRoomLocation String?
  specialObservations   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  pool                  Pool     @relation(fields: [poolId], references: [id])

  @@index([disinfectionType])
}

model KeyAccess {
  id                   Int         @id @default(autoincrement())
  keyCode              String      @unique
  description          String?
  requiredForVisit     Boolean     @default(false)
  visibleToTechnician  Boolean     @default(true)
  assignedTechnicianId Int?
  assignedAt           DateTime?
  active               Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  assignedTechnician   Technician? @relation(fields: [assignedTechnicianId], references: [id])
  pools                Pool[]      @relation("KeyAccessToPool")

  @@index([keyCode])
  @@index([assignedTechnicianId])
  @@index([requiredForVisit])
  @@index([visibleToTechnician])
  @@index([active])
}

model Attachment {
  id             Int             @id @default(autoincrement())
  fileName       String
  fileUrl        String
  mimeType       String
  fileSize       Int
  clientId       Int?
  poolId         Int?
  serviceVisitId Int?
  alertId        Int?
  repairId       Int?
  invoiceId      Int?
  createdAt      DateTime        @default(now())
  alert          TechnicalAlert? @relation(fields: [alertId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  pool           Pool?           @relation(fields: [poolId], references: [id])
  repair         Repair?         @relation(fields: [repairId], references: [id])
  serviceVisit   ServiceVisit?   @relation(fields: [serviceVisitId], references: [id])

  @@index([clientId])
  @@index([poolId])
  @@index([serviceVisitId])
  @@index([alertId])
  @@index([repairId])
  @@index([invoiceId])
}

model OperationalReminder {
  id                     Int         @id @default(autoincrement())
  title                  String
  description            String?
  dueDate                DateTime
  isCompleted            Boolean     @default(false)
  clientId               Int?
  poolId                 Int?
  assignedToTechnicianId Int?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  assignedTechnician     Technician? @relation(fields: [assignedToTechnicianId], references: [id])
  client                 Client?     @relation(fields: [clientId], references: [id])
  pool                   Pool?       @relation(fields: [poolId], references: [id])

  @@index([dueDate])
  @@index([isCompleted])
  @@index([clientId])
  @@index([poolId])
  @@index([assignedToTechnicianId])
}

enum ArchiveStatus {
  ATIVO
  PAUSA
  ARQUIVADO
}
