generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Client {
  id                            Int                   @id @default(autoincrement())
  name                          String
  internalName                  String?
  email                         String?
  phone                         String?
  address                       String?
  zone                          String?
  notes                         String?
  status                        String                @default("ACTIVE")
  active                        Boolean               @default(true)
  password                      String?
  pin                           String?
  lastLogin                     DateTime?
  latitude                      Float?
  longitude                     Float?
  arrivalNotify                 Boolean               @default(false)
  arrivalAllowed                Boolean               @default(true)
  monthlyFee                    Float?                @default(0)
  monthlyAmount                 Float?                @default(0)
  creditBalance                 Float                 @default(0)
  lastPaymentAt                 DateTime?
  paymentStatus                 String                @default("PAID")
  requiresInvoice               Boolean               @default(false)
  billingActive                 Boolean               @default(false)
  contractActivatedAt           DateTime?
  fiscalName                    String?
  fiscalNif                     String?
  fiscalAddress                 String?
  fiscalEmail                   String?
  externalBillingNotes          String?
  paymentReminderMode           String                @default("DEFAULT")
  paymentReminderEmail          Boolean               @default(true)
  paymentReminderEmailAddress   String?
  paymentReminderWhatsapp       Boolean               @default(true)
  paymentReminderWhatsappNumber String?
  paymentReminderInternal       Boolean               @default(true)
  lastReminderAt                DateTime?
  lastReminderMonth             String?
  pauseReason                   String?
  pauseUntil                    DateTime?
  source                        String?
  createdByTechnicianId         Int?
  pendingReview                 Boolean               @default(false)
  reviewStatus                  String                @default("APPROVED")
  reviewedAt                    DateTime?
  reviewedByUserId              Int?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  archiveStatus                 ArchiveStatus         @default(ATIVO)
  deletedAt                     DateTime?
  contractActive                Boolean               @default(false)
  attachments                   Attachment[]
  chatMessages                  ChatMessage[]
  accesses                      ClientAccess[]
  messages                      ClientMessage[]
  reportSetting                 ClientReportSetting?
  communicationLogs             CommunicationLog[]
  extraVisits                   ExtraVisit[]
  invoices                      Invoice[]
  reports                       MonthlyReport[]
  notifications                 Notification[]
  operationalReminders          OperationalReminder[]
  pools                         Pool[]
  refreshTokens                 RefreshToken[]
  serviceVisits                 ServiceVisit[]
  tasks                         Task[]
  visits                        Visit[]

  @@index([name])
  @@index([zone])
  @@index([status])
  @@index([paymentStatus])
  @@index([lastReminderMonth])
  @@index([pendingReview])
  @@index([reviewStatus])
  @@index([createdByTechnicianId])
}

model ClientAccess {
  id                  Int      @id @default(autoincrement())
  clientId            Int
  title               String?
  accessType          String?
  codeValue           String?
  instructions        String?
  visibleToTechnician Boolean  @default(true)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  client              Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([active])
}

model ClientMessage {
  id            Int       @id @default(autoincrement())
  clientId      Int
  sender        String?
  senderType    String?
  message       String?
  text          String?
  isReadByAdmin Boolean   @default(false)
  seen          Boolean   @default(false)
  fileUrl       String?
  fileName      String?
  messageType   String?   @default("TEXT")
  createdAt     DateTime  @default(now())
  seenAt        DateTime?
  client        Client    @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([createdAt])
  @@index([isReadByAdmin])
}

model ClientReportSetting {
  id                  Int      @id @default(autoincrement())
  clientId            Int      @unique
  showClientName      Boolean  @default(true)
  showPoolName        Boolean  @default(true)
  showAddress         Boolean  @default(true)
  showZone            Boolean  @default(true)
  showTechnicianName  Boolean  @default(true)
  showPlannedDate     Boolean  @default(true)
  showStartEnd        Boolean  @default(true)
  showStatus          Boolean  @default(true)
  showChecklist       Boolean  @default(true)
  showWaterParameters Boolean  @default(true)
  showChemicals       Boolean  @default(true)
  showPhotos          Boolean  @default(true)
  showEquipment       Boolean  @default(true)
  showTechnicalRoom   Boolean  @default(true)
  showNotes           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  client              Client   @relation(fields: [clientId], references: [id])
}

model Pool {
  id                    Int                     @id @default(autoincrement())
  clientId              Int
  name                  String?
  location              String?
  address               String?
  zone                  String?
  zoneId                Int?
  volumeM3              Float?
  type                  String?
  priority              Int                     @default(0)
  active                Boolean                 @default(true)
  notes                 String?
  latitude              Float?
  longitude             Float?
  monthlyAmount         Float                   @default(0)
  serviceFrequency      Int                     @default(1)
  preferredDays         String?
  scheduleMode          String                  @default("AUTO")
  estimatedMinutes      Int                     @default(30)
  hasLights             Boolean                 @default(true)
  source                String?
  createdByTechnicianId Int?
  pendingReview         Boolean                 @default(false)
  reviewStatus          String                  @default("APPROVED")
  reviewedAt            DateTime?
  reviewedByUserId      Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  archiveStatus         ArchiveStatus           @default(ATIVO)
  deletedAt             DateTime?
  attachments           Attachment[]
  extraVisits           ExtraVisit[]
  extraVisitRules       ExtraVisitRule[]
  operationalReminders  OperationalReminder[]
  client                Client                  @relation(fields: [clientId], references: [id])
  zoneRecord            Zone?                   @relation(fields: [zoneId], references: [id])
  calculationProfile    PoolCalculationProfile?
  equipment             PoolEquipment?
  poolMessages          PoolMessage[]
  repairs               Repair[]
  roundPools            RoundPool[]
  services              Service[]
  serviceVisits         ServiceVisit[]
  tasks                 Task[]
  technicalAlerts       TechnicalAlert[]
  technicalHistory      TechnicalHistory[]
  technicalRoom         TechnicalRoom?
  technicalSheet        TechnicalSheet?
  visits                Visit[]
  keyAccesses           KeyAccess[]             @relation("KeyAccessToPool")

  @@index([clientId])
  @@index([active])
  @@index([name])
  @@index([zone])
  @@index([pendingReview])
  @@index([reviewStatus])
  @@index([createdByTechnicianId])
}

model PoolCalculationProfile {
  id                   Int      @id @default(autoincrement())
  poolId               Int      @unique
  shape                String   @default("RECTANGULAR")
  lengthM              Float?
  widthM               Float?
  diameterM            Float?
  depthMinM            Float?
  depthMaxM            Float?
  averageDepthM        Float?
  shapeFactor          Float?   @default(1)
  surfaceM2            Float?
  volumeM3             Float?
  pumpFlowM3h          Float?
  pumpPowerHp          Float?
  bathersAverage       Float?   @default(0)
  poolLoad             String   @default("NORMAL")
  saltCurrentPpm       Float?
  targetSalinityPpm    Float?   @default(3500)
  chlorinatorGph       Float?
  chlorineCurrentPpm   Float?
  targetChlorinePpm    Float?   @default(2)
  heatPumpPhase        String?
  heatPumpThermalKw    Float?
  heatPumpElectricalKw Float?
  cop                  Float?   @default(5)
  currentWaterTempC    Float?
  targetWaterTempC     Float?   @default(27)
  covered              Boolean  @default(false)
  ambientLossFactor    Float?
  notes                String?
  lastResultJson       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  pool                 Pool     @relation(fields: [poolId], references: [id])

  @@index([shape])
  @@index([poolLoad])
}

model PoolEquipment {
  id                Int       @id @default(autoincrement())
  poolId            Int       @unique
  type              String?
  brand             String?
  model             String?
  pumpType          String?
  pumpPower         String?
  filterType        String?
  filterMedia       String?
  saltSystem        Boolean   @default(false)
  saltLastAdded     DateTime?
  saltQuantity      Float?
  lightsCount       Int?
  lightsType        String?
  hasLights         Boolean   @default(true)
  brokenLightsCount Int?      @default(0)
  lightsNotes       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  pool              Pool      @relation(fields: [poolId], references: [id])
}

model TechnicalRoom {
  id           Int      @id @default(autoincrement())
  poolId       Int      @unique
  condition    String?
  locationNote String?
  ventilation  String?
  electrical   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pool         Pool     @relation(fields: [poolId], references: [id])
}

model Technician {
  id                   Int                    @id @default(autoincrement())
  name                 String
  phone                String?
  email                String?                @unique
  pin                  String?
  role                 String                 @default("TECHNICIAN")
  zone                 String?
  vehicleId            Int?
  latitude             Float?
  longitude            Float?
  notes                String?
  active               Boolean                @default(true)
  costPerVisit         Float                  @default(0)
  hourlyCost           Float                  @default(0)
  commissionRate       Float                  @default(0.10)
  lastLogin            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  archiveStatus        ArchiveStatus          @default(ATIVO)
  deletedAt            DateTime?
  extraVisits          ExtraVisit[]
  heldKeys             KeyAccess[]
  operationalReminders OperationalReminder[]
  roundTechnicians     RoundTechnician[]
  services             Service[]
  serviceVisits        ServiceVisit[]
  tasks                Task[]
  vehicle              Vehicle?               @relation("TechnicianAssignedVehicle", fields: [vehicleId], references: [id])
  locations            TechnicianLocation[]
  tracks               TechnicianTrack[]
  vehicleLogs          TechnicianVehicleLog[]
  visits               Visit[]
  workGuides           WorkGuide[]

  @@index([name])
  @@index([active])
  @@index([vehicleId])
  @@index([zone])
}

model User {
  id                   Int                       @id @default(autoincrement())
  email                String                    @unique
  password             String
  role                 String                    @default("TECH")
  name                 String?
  phone                String?
  pin                  String?
  active               Boolean                   @default(true)
  mustChangePassword   Boolean                   @default(false)
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  failedLoginAttempts  Int                       @default(0)
  lockedUntil          DateTime?
  avatarUrl            String?
  username             String?
  costPerVisit         Float                     @default(0)
  hourlyCost           Float                     @default(0)
  commissionRate       Float                     @default(0.10)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  chatMessagesReceived ChatMessage[]             @relation("ChatReceiver")
  chatMessagesSent     ChatMessage[]             @relation("ChatSender")
  extraVisits          ExtraVisit[]
  locationLogs         LocationLog[]
  notifications        Notification[]
  technicianLocation   TechnicianLocation?
  technicianTracks     TechnicianTrack[]
  technicianWorkDays   TechnicianWorkDay[]
  notificationSettings UserNotificationSetting[]

  @@index([role])
  @@index([active])
}

model ServiceVisit {
  id             Int             @id @default(autoincrement())
  clientId       Int?
  poolId         Int?
  technicianId   Int?
  roundId        Int?
  technicianName String?
  date           DateTime        @default(now())
  plannedDate    DateTime?
  startAt        DateTime?
  endAt          DateTime?
  status         String          @default("PLANNED")
  reason         String?
  notes          String?
  internalNotes  String?
  alerts         String?
  products       String?
  chemicalsJson  Json?
  ph             Float?
  chlorine       Float?
  alkalinity     Float?
  salt           Float?
  temperature    Float?
  cleaned        Boolean         @default(false)
  brushed        Boolean         @default(false)
  vacuumed       Boolean         @default(false)
  basketCleaned  Boolean         @default(false)
  waterlineClean Boolean         @default(false)
  backwashDone   Boolean         @default(false)
  billed         Boolean         @default(false)
  billedAt       DateTime?
  cost           Float           @default(0)
  revenue        Float           @default(0)
  profit         Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orpMv          Float?
  attachments    Attachment[]
  chemicals      ChemicalUsage[]
  client         Client?         @relation(fields: [clientId], references: [id])
  pool           Pool?           @relation(fields: [poolId], references: [id])
  round          Round?          @relation(fields: [roundId], references: [id])
  technician     Technician?     @relation(fields: [technicianId], references: [id])
  photos         VisitPhoto[]

  @@index([clientId])
  @@index([poolId])
  @@index([technicianId])
  @@index([roundId])
  @@index([date])
  @@index([plannedDate])
  @@index([status])
}

model VisitPhoto {
  id        Int          @id @default(autoincrement())
  visitId   Int
  url       String
  type      String       @default("GENERAL")
  createdAt DateTime     @default(now())
  visit     ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([type])
}

model ChemicalUsage {
  id        Int          @id @default(autoincrement())
  visitId   Int
  name      String
  quantity  Float        @default(0)
  unit      String?
  createdAt DateTime     @default(now())
  visit     ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model Round {
  id            Int               @id @default(autoincrement())
  name          String
  dayOfWeek     Int
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  pools         RoundPool[]
  technicians   RoundTechnician[]
  serviceVisits ServiceVisit[]

  @@index([dayOfWeek])
  @@index([active])
}

model RoundTechnician {
  id           Int        @id @default(autoincrement())
  roundId      Int
  technicianId Int
  round        Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id])

  @@unique([roundId, technicianId])
  @@index([technicianId])
}

model RoundPool {
  id      Int   @id @default(autoincrement())
  roundId Int
  poolId  Int
  order   Int   @default(0)
  pool    Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, poolId])
  @@index([poolId])
  @@index([roundId, order])
}

model ExtraVisitRule {
  id             Int          @id @default(autoincrement())
  poolId         Int
  name           String?
  description    String?
  active         Boolean      @default(true)
  recurrenceType String       @default("SEASONAL")
  yearMode       String       @default("EVERY_YEAR")
  startDate      DateTime?
  endDate        DateTime?
  visitsPerWeek  Int          @default(1)
  monday         Boolean      @default(false)
  tuesday        Boolean      @default(false)
  wednesday      Boolean      @default(false)
  thursday       Boolean      @default(false)
  friday         Boolean      @default(false)
  saturday       Boolean      @default(false)
  sunday         Boolean      @default(false)
  preferredTime  String?
  billingMode    String       @default("EXTRA")
  unitPrice      Float?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  visits         ExtraVisit[]
  pool           Pool         @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([active])
}

model ExtraVisit {
  id                Int             @id @default(autoincrement())
  clientId          Int?
  poolId            Int?
  ruleId            Int?
  technicianId      Int?
  userId            Int?
  visitType         String          @default("ONE_OFF")
  type              String?
  source            String          @default("MANUAL")
  origin            String          @default("ADMIN")
  scheduledAt       DateTime        @default(now())
  date              DateTime?
  status            String          @default("PLANNED")
  billingMode       String          @default("EXTRA")
  billingStatus     String          @default("NOT_BILLABLE")
  commercialRule    String          @default("INCLUDED")
  isBillable        Boolean         @default(false)
  unitPrice         Float?
  totalPrice        Float?
  price             Float           @default(0)
  includedInPackage Boolean         @default(false)
  billed            Boolean         @default(false)
  billedAt          DateTime?
  notes             String?
  internalNote      String?
  cancelReason      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  client            Client?         @relation(fields: [clientId], references: [id])
  pool              Pool?           @relation(fields: [poolId], references: [id])
  rule              ExtraVisitRule? @relation(fields: [ruleId], references: [id])
  technician        Technician?     @relation(fields: [technicianId], references: [id])
  user              User?           @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([poolId])
  @@index([technicianId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
}

model MonthlyReport {
  id        Int      @id @default(autoincrement())
  month     String
  type      String
  clientId  Int?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])

  @@unique([month, type, clientId])
  @@index([clientId])
  @@index([month])
  @@index([type])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  clientId          Int
  monthRef          String?
  year              Int?
  month             String?
  amount            Float         @default(0)
  amountCents       Int           @default(0)
  total             Float         @default(0)
  totalCents        Int           @default(0)
  subtotal          Float         @default(0)
  subtotalCurrent   Float         @default(0)
  subtotalArrears   Float         @default(0)
  taxRate           Float         @default(0)
  taxAmount         Float         @default(0)
  totalAmount       Float         @default(0)
  amountPaid        Float         @default(0)
  amountOpen        Float         @default(0)
  status            String        @default("PENDING")
  paymentMethod     String?
  notes             String?
  paidAt            DateTime?
  dueDate           DateTime?
  issueDate         DateTime?
  invoiceNumber     String?       @unique
  externalInvoiceNo String?
  invoiceIssued     Boolean       @default(false)
  requiresInvoice   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attachments       Attachment[]
  client            Client        @relation(fields: [clientId], references: [id])
  lines             InvoiceLine[]
  payments          Payment[]

  @@unique([clientId, monthRef])
  @@index([clientId])
  @@index([year, month])
  @@index([status])
  @@index([dueDate])
  @@index([clientId, status])
  @@index([dueDate, status])
  @@index([requiresInvoice])
  @@index([invoiceIssued])
}

model InvoiceLine {
  id          Int       @id @default(autoincrement())
  invoiceId   Int
  type        String?
  lineType    String?
  description String
  referenceId Int?
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  total       Float     @default(0)
  lineTotal   Float     @default(0)
  serviceDate DateTime?
  sourceMonth String?
  notes       String?
  createdAt   DateTime  @default(now())
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([type])
  @@index([lineType])
  @@index([referenceId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  amount      Float
  amountCents Int      @default(0)
  method      String?  @default("MANUAL")
  notes       String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
}

model Repair {
  id          Int          @id @default(autoincrement())
  poolId      Int
  problem     String
  quantity    Int          @default(1)
  unitPrice   Float?
  totalPrice  Float?
  priority    String       @default("NORMAL")
  notes       String?
  status      String       @default("PENDING")
  paid        Boolean      @default(false)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  doneAt      DateTime?
  attachments Attachment[]
  pool        Pool         @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TechnicalHistory {
  id            Int       @id @default(autoincrement())
  poolId        Int
  type          String    @default("MAINTENANCE")
  component     String?
  message       String?
  description   String?
  status        String?
  performedAt   DateTime?
  doneAt        DateTime?
  nextSuggested DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pool          Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([type])
}

model TechnicalAlert {
  id          Int          @id @default(autoincrement())
  poolId      Int
  type        String
  message     String
  priority    String       @default("NORMAL")
  status      String       @default("OPEN")
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  attachments Attachment[]
  pool        Pool         @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([status])
}

model Alert {
  id         Int       @id @default(autoincrement())
  title      String?
  message    String?
  type       String?
  status     String    @default("OPEN")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([active])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int?
  clientId  Int?
  type      String    @default("GENERAL")
  eventType String?
  title     String?
  message   String
  role      String?
  status    String    @default("PENDING")
  severity  String?
  metadata  Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  client    Client?   @relation(fields: [clientId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([type])
  @@index([eventType])
  @@index([role])
  @@index([isRead])
  @@index([readAt])
  @@index([createdAt])
}

model NotificationRule {
  id              Int      @id @default(autoincrement())
  eventType       String
  roles           String?
  channels        String?
  active          Boolean  @default(true)
  defaultEmail    Boolean  @default(true)
  defaultWhatsapp Boolean  @default(true)
  defaultInternal Boolean  @default(true)
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([eventType])
  @@index([active])
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  role      String?
  clientId  Int?
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([active])
}

model EmailLog {
  id          Int       @id @default(autoincrement())
  to          String?
  toEmail     String?
  subject     String?
  eventType   String?
  type        String?
  mode        String?
  status      String    @default("PENDING")
  error       String?
  html        String?
  text        String?
  retryCount  Int       @default(0)
  lastRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([to])
  @@index([toEmail])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model CommunicationLog {
  id          Int      @id @default(autoincrement())
  clientId    Int?
  channel     String
  message     String
  referenceId Int?
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([channel])
  @@index([createdAt])
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  senderId    Int?
  receiverId  Int?
  clientId    Int?
  chatType    String   @default("INTERNAL")
  channel     String?
  text        String?
  message     String?
  messageType String   @default("TEXT")
  fileUrl     String?
  fileName    String?
  latitude    Float?
  longitude   Float?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id])
  receiver    User?    @relation("ChatReceiver", fields: [receiverId], references: [id])
